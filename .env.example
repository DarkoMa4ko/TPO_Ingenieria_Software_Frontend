# Modo de datos del frontend:
#   (sin definir) o auto -> usa el backend y, si no responde, pasa a modo demo.
#   true                 -> siempre modo demo (no necesita backend).
#   false                -> siempre backend (muestra error si no está).
# VITE_DEMO=auto

# En desarrollo (npm run dev) dejar VITE_API_URL vacío: Vite redirige /api al backend (proxy).
# Sólo si se accede a la build de producción hospedada en otro origen, poner la URL completa:
# VITE_API_URL=http://localhost:8080
